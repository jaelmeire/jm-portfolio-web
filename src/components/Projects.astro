---
import { allProjectsData } from '../data/projectsData.js';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import ProjectLightbox from '../components/portfolio/ProjectLightbox.astro';

const portfolioProjects = allProjectsData.filter(p => p.section === 'portfolio');
---

<section id="portfolio" class="max-w-5xl mx-auto px-6 py-24" data-lightbox-scope="portfolio-lightbox">
  <div class="mb-10">
    <p class="text-xs tracking-widest text-gray-500 text-center mb-4">PORTFOLIO</p>
    <h2 class="text-3xl font-bold text-center mb-3">Featured Work</h2>
    <p class="text-gray-400 text-center max-w-2xl mx-auto mb-16">
      A selection of real projects and design work showcasing performance,
      clean code, and user-focused solutions.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6">
    {portfolioProjects.map(project => (
      <ProjectCard {...project} />
    ))}
  </div>

  <ProjectLightbox projects={portfolioProjects} instanceId="portfolio-lightbox" />
</section>

<script src="../scripts/lightbox.ts"></script>